{
  "name": "sample-app",
  "productName": "Sample App",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Electron app showing how an externally built/hosted app consumes Releaser for targeted updates.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.example.sample-app",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://cdn.example.com/sample-app/${version}"
      }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": ["zip", "dmg"] },
    "linux": { "target": "AppImage" }
  }
}
