# Copy to .env and change every secret. See docs/configuration.md for all settings.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
RELEASER_ADMIN_EMAIL=admin@example.com
# Used only to create the first administrator when none exists. Change it after first sign-in.
RELEASER_ADMIN_PASSWORD=change-me-at-least-12-chars
# Public URL your Electron apps and administrators use (behind your TLS reverse proxy).
RELEASER_PUBLIC_BASE_URL=http://localhost:8080
RELEASER_PORT=8080
RELEASER_FRESHNESS_SECONDS=5
# Set true only when a reverse proxy you control is the only way to reach the app.
RELEASER_TRUST_FORWARDED_HEADERS=false
# Feed requests per client IP per minute (corporate NATs may need more).
RELEASER_CLIENT_RATE_LIMIT_PER_MINUTE=600
