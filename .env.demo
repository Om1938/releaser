# DEMO ONLY — never use these values for a real installation.
POSTGRES_PASSWORD=demo-password-not-secret
RELEASER_ADMIN_EMAIL=admin@example.com
RELEASER_ADMIN_PASSWORD=ChangeMe-Demo-Only-1
RELEASER_PUBLIC_BASE_URL=http://localhost:8080
# The sample artifact host is plain http on the private Docker network.
RELEASER_ALLOW_INSECURE_MANIFESTS=true
RELEASER_ALLOW_PRIVATE_MANIFEST_HOSTS=true
# The demo simulates thousands of installations from one container IP.
RELEASER_CLIENT_RATE_LIMIT_PER_MINUTE=100000
