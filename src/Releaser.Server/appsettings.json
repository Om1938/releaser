{
  "ConnectionStrings": {
    "Releaser": "Host=localhost;Port=5432;Database=releaser;Username=releaser;Password=releaser"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Resolution": { "FreshnessSeconds": 5 },
  "Manifests": { "AllowInsecureHttp": false, "AllowPrivateNetworks": false, "TimeoutSeconds": 10 },
  "ContextTokens": { "MaxLifetimeHours": 24 },
  "RateLimits": { "ClientPerMinute": 600, "LoginPerMinute": 10 },
  "Database": { "MigrateOnStartup": true },
  "Platform": { "PublicBaseUrl": "http://localhost:8080" },
  "AllowedHosts": "*"
}
